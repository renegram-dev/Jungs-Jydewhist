rules_version = '2';

// Security model for Jungs-Jydewhist (cloud-first):
//   history/main  - the ONE permanent history. Only the owner's verified Google
//                   account may read/create/update. Nobody can delete it.
//   config/access - { ownerEmail: "<google address>" }, created by hand in the
//                   Firebase console so the address is never committed to the
//                   (public) repo. Not readable/writable by clients.
//   sharedGames/* - LEGACY rooms from the old anonymous app. Rules unchanged on
//                   purpose (the previous build keeps working for rollback).
//
// Deploy (no CLI needed): Firebase Console -> Firestore Database -> Rules ->
// paste this file -> Publish. See docs/cloud-setup.md.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email ==
           get(/databases/$(database)/documents/config/access).data.ownerEmail;
    }

    match /history/{docId} {
      allow get: if docId == 'main' && isOwner();
      allow list: if false;
      allow create: if docId == 'main' && isOwner();
      allow update: if docId == 'main' && isOwner();
      allow delete: if false;
    }

    // Never accessible from the client (only read by the rules above).
    match /config/{docId} {
      allow read, write: if false;
    }

    // --- LEGACY (unchanged) ---
    match /sharedGames/{roomCode} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid;

      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;
    }

    // Everything else is denied by default.
  }
}
